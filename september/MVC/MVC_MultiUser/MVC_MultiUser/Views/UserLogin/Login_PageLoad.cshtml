@model MVC_MultiUser.Models.loginclss
@{
    ViewBag.Title = "Login_PageLoad";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>login_pageload</h2>
<div>
    @using (Html.BeginForm("Login_Click", "UserLogin", FormMethod.Post))
    {
        <div>
            <label>User Name:</label>
        </div>
        <div>
            @Html.TextBoxFor(m => m.uname)
            @Html.ValidationMessageFor(m => m.uname)
        </div>
        <div>
            <label>Password:</label>
        </div>
        <div>
            @Html.PasswordFor(m => m.password)
            @Html.ValidationMessageFor(m => m.password)
        </div>
        <div>
            <input type="submit" value="login" />
            @Html.DisplayFor(m => m.msg)
        </div>}

</div>

