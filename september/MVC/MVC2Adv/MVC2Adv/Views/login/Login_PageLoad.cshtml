@model MVC2Adv.Models.loginclss
@{
    ViewBag.Title = "Login_PageLoad";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>User Login</h2>
<div>
    @using (Html.BeginForm("Login_Click", "login", FormMethod.Post))
    {
        <div>
            <label>User Name:</label>
        </div>
        <div>
            @Html.TextBoxFor(m => m.Username)
            @Html.ValidationMessageFor(m => m.Username)
        </div>
        <div>
            <label>Password:</label>
        </div>
        <div>
            @Html.TextBoxFor(m => m.pwd)
            @Html.ValidationMessageFor(m => m.pwd)
        </div>
        <div>
            <input type="submit" value="login" />
            @Html.DisplayFor(m => m.msg)
        </div>
    }
</div>

