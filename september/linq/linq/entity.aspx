<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="entity.aspx.cs" Inherits="linq.entity" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title></title>
    <style type="text/css">
        .auto-style1 {
