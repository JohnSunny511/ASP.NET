@model IEnumerable<COREMvcBasicApp.Models.Employee>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-rGc5a4CZNrDyZM96D/AJLHaaLgMQp8rCw+3Mi6lO2eNg6bPqfgJInQFnZlA1a11K" crossorigin="anonymous"></script>
<form asp-action="DisplayAll_Pageload" asp-controller="DisplayAll" method="get">
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Address</th>
                <th>Salary</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in ViewBag.userdetails)
            {
                <tr>
                    <td>@item.eid</td>
                    <td>@item.ename</td>
                    <td>@item.eaddr</td>
                    <td>@item.esal</td>
                </tr>
            }
        </tbody>
    </table>
</form>