@model IEnumerable<MVC_CORE_APP_2.Models.Employeecls>
<div>
    @Html.ActionLink("Insert new Employee", "Insert_Load");
</div>

<h2>List all employee details</h2>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Address</th>
            <th>Salary</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var emp in Model)
        {
            <tr>
                <td>@emp.eid</td>
                <td>@emp.ename</td>
                <td>@emp.eaddr</td>
                <td>@emp.esal</td>
                <td>@Html.ActionLink("Delete", "Deletetab", "DisplayAll", new { id = emp.eid })</td>
                <td>@Html.ActionLink("Details", "Detailstab", "DisplayAll", new { id = emp.eid })</td>
                <td>@Html.ActionLink("Edit","Edittab","DisplayAll",new{id = emp.eid})</td>
            </tr>
        }
    </tbody>
</table>
