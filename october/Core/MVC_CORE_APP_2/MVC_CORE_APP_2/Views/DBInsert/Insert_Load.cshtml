@model MVC_CORE_APP_2.Models.Employeecls

<form asp-action="Insert_Click" class="form-horizondal">
    <div class="form-group">
        <label class="control-label">Employee Name</label>
        <input asp-for="ename" class="form-control" />
    </div>
    <div class="form-group">
        <label class="control-label">Employee Address</label>
        <input asp-for="eaddr" class="form-control" />
    </div>
    <div class="form-group">
        <label class="control-label">Employee Salary</label>
        <input asp-for="esal" class="form-control" />
    </div>
    <div class="form-group">
        <input type="submit" value="Insert" class="btn btn-success" />
    </div>
</form>